# Copy this file to .env.local and fill in real values (see README.md for
# where each one comes from). .env.local is gitignored — never commit it.

# Supabase project (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key (Settings > API) — bypasses every RLS policy, so treat it
# like a password. Used by scripts/migrate-to-supabase.mjs AND by the daily
# email summary (src/app/api/cron/daily-digest) and the admin notice for new
# access requests, which run with no signed-in user and so can't read
# members/pending_changes any other way. Set it on Vercel too, or those
# emails silently never send ("supabaseKey is required").
SUPABASE_SERVICE_ROLE_KEY=

# 32-byte key for encrypting contact details (phone/email/address) at the
# app layer before they're stored — Supabase itself, and any backup file,
# only ever sees ciphertext. This DOES need to be set on Vercel too (unlike
# the service role key above), since the live app uses it on every request
# that reads or writes contact info. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing this key permanently locks everyone out of their own contact
# details — back it up somewhere safe alongside your Supabase credentials.
VAULT_ENCRYPTION_KEY=

# Resend (resend.com) — for the two notification emails: admins get pinged
# when a change is submitted, submitters get pinged when it's decided.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
